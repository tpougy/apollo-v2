{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "shared/**/*.ts",
      "web/src/**/*.ts",
      "web/src/**/*.svelte",
      "web/vite.config.ts",
      "web/e2e/**/*.ts",
      "web/playwright.config.ts"
    ],
    "ignoreUnknown": true
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
